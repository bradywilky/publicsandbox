DISCORD_BOT_TOKEN=your_discord_bot_token
ALLOWED_DISCORD_USER_ID=123456789012345678
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-mini

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
